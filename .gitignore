# env files — keep local ones secret
.env
.env.local
.env*.local
.env.development
.env.production
.env.vercel

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*

# MCP static client secrets (OAuth tokens, dynamic client registration)
/scripts/.mcp/

# local tooling / scratch
.codegraph/
src/sds
scripts/diag-*.js
scripts/grep-inngest.js
