/* ============================================
   SWEATRS COACHING - Pure CSS Stylesheet
   Converted from Tailwind CSS
   ============================================ */

/* --- CSS Custom Properties --- */
:root {
    --color-error: #ba1a1a;
    --color-primary: #141414;
    --color-gold: #b8860b;
    --color-gold-light: #d4af37;
    --color-gold-deep: #8c6504;
    --color-surface: #fbf9f5;
    --color-surface-card: #ffffff;
    --color-surface-muted: #f5f3ef;
    --color-surface-border: #e5e2de;
    --color-on-surface: #141414;
    --color-on-surface-variant: #4d4a46;
    --color-outline: #747878;
    --color-outline-light: #e6e4df;
    --color-background: #fbf9f5;
}

/* --- Base / Reset --- */

html,
body {
    margin: 0;
    padding: 0;
}

body {
    overscroll-behavior: none;
}

main> :first-child {
    margin-top: 0 !important;
}

main> :last-child {
    margin-bottom: 0 !important;
}

::selection {
    background: rgba(253, 209, 133, 0.4);
    color: black;
}

/* --- Body --- */
.site-body {
    background-color: var(--color-background);
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    color: var(--color-on-surface);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
}

/* --- Header --- */
.site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-surface-border);
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.03);
}

.header-inner {
    height: 5rem;
    max-width: 1360px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.brand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: opacity 0.15s ease;
}

.brand-link:hover {
    opacity: 0.85;
}

.brand-img-wrapper {
    height: 2.5rem;
    width: 6rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.brand-img {
    height: 3.5rem;
    width: auto;
    object-fit: cover;
    filter: contrast(1.5);
}

.brand-text {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.25rem;
    letter-spacing: 0.2em;
    color: #141414;
    display: none;
    font-weight: 500;
}

.main-nav {
    display: none;
    align-items: center;
    gap: 2rem;
}

:not(.header--menu-open) .header-nav-wrapper button,
:not(.header--menu-open) .header-nav-wrapper a {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #57534e;
    transition: color 0.15s ease;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
}

:not(.header--menu-open) .header-nav-wrapper button:hover,
:not(.header--menu-open) .header-nav-wrapper a:hover {
    color: var(--color-gold);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
}

.btn-cta-primary {
    display: none;
    align-items: center;
    justify-content: center;
    background: #141414;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0.25rem;
    border: 1px solid #141414;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-cta-primary:hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
}

.btn-icon-circle {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: #f5f5f4;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, border-color 0.15s ease;
    text-decoration: none;
}

.btn-icon-circle:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
}

.btn-icon-circle .material-symbols-outlined {
    color: #292524;
    font-size: 18px;
}

/* --- Main --- */
.site-main {
    width: 100%;
    padding-top: 5rem;
    background-color: var(--color-background);
    position: relative;
}

/* --- Hero Section --- */
.hero {
    position: relative;
    width: 100%;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #fcfbf9;
}

.hero-bg-pattern {
    position: absolute;
    inset: 0;
    background: radial-gradient(#e5e2de 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.4;
}

.hero-inner {
    position: relative;
    max-width: 1360px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
}

.hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    z-index: 10;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid #e7e5e4;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    margin-bottom: 1.5rem;
}

.hero-badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-gold);
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.hero-badge-text {
    font-size: 11px;
    font-weight: 600;
    color: #44403c;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

.hero-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 2.25rem;
    color: var(--color-primary);
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
    font-weight: 400 !important;
    font-style: oblique;
    text-transform: capitalize;
}

.hero-title-gradient {
    font-style: italic;
    font-weight: 400;
    color: transparent;
    background: linear-gradient(to right, var(--color-gold), var(--color-gold-light), var(--color-gold-deep));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-description {
    font-family: 'Manrope', sans-serif;
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    max-width: 36rem;
    margin-bottom: 2rem;
    line-height: 1.625;
}

.hero-buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    width: 100%;
    margin-bottom: 2.5rem;
}

.btn-primary-lg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #141414;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    padding-left: 2rem;
    padding-right: 2rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-radius: 0.25rem;
    letter-spacing: 0.2em;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    text-align: center;
    text-decoration: none;
}

.btn-primary-lg:hover {
    background: var(--color-gold);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}

.btn-primary-sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #141414;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: .5rem;
    padding-bottom: .5rem;
    border-radius: 0.25rem;
    letter-spacing: 0.2em;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    text-align: center;
    text-decoration: none;
}

.btn-primary-sm:hover {
    background: var(--color-gold);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}

.btn-outline-lg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    color: #292524;
    letter-spacing: 0.2em;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-radius: 0.25rem;
    border: 1px solid #d6d3d1;
    transition: color 0.2s ease, border-color 0.2s ease;
    text-align: center;
    background: rgba(255, 255, 255, 0.7);
    text-decoration: none;
}

.btn-outline-lg:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
}

.btn-outline-lg .material-symbols-outlined {
    font-size: 16px;
    margin-left: 0.25rem;
}

.hero-trust {
    padding-top: 1.5rem;
    border-top: 1px solid #e7e5e4;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    color: #57534e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.hero-trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.hero-trust-item .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 18px;
}

.hero-trust-separator {
    color: #d6d3d1;
}

.hero-image-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    position: relative;
}

.hero-image-frame {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4/5;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    border: 4px solid #ffffff;
    background: #f5f5f4;
}

.hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(100%) contrast(1.25);
    transition: transform 0.7s ease;
}

.hero-image:hover {
    transform: scale(1.05);
}

.hero-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent, transparent);
}

.hero-image-info-card {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(231, 229, 228, 0.8);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.hero-image-info-card .info-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold);
}

.hero-image-info-card .info-name {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.125rem;
    color: #1c1917;
    font-weight: 500;
}

.hero-image-info-card .info-subtitle {
    font-size: 11px;
    color: #78716c;
    letter-spacing: 0.05em;
}

/* --- Problem / Promise Section --- */
.problem-section {
    width: 100%;
    background: #f8f6f0;
    padding-top: 5rem;
    padding-bottom: 5rem;
}

.section-container {
    max-width: 1360px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}

.section-container-narrow {
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}

.section-container-medium {
    max-width: 1240px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}

.section-header-centered {
    text-align: center;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
}

.section-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
}

.section-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.875rem;
    color: #1c1917;
    margin: 0;
}

.section-title-lg {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.875rem;
    color: #1c1917;
}

.problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
}

.problem-card {
    padding: 2rem;
    background: #ffffff;
    border: 1px solid rgba(231, 229, 228, 0.8);
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
}

.problem-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    border-color: rgba(184, 134, 11, 0.6);
}

.problem-card-icon-box {
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    background: #fffbeb;
    border: 1px solid #fef3c7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
}

.problem-card-icon-box .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 26px;
}

.problem-card-strikethrough {
    font-size: 1.125rem;
    font-weight: 500;
    color: #000000;
    text-decoration-color: #d6d3d1;
    margin-bottom: 0.5rem;
}

.problem-card-protocol-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.25rem;
}

.problem-card-text {
    font-size: 0.875rem;
    color: #44403c;
    line-height: 1.625;
}

.problem-card-divider {
    padding-top: 1rem;
    border-top: 1px solid #f5f5f4;
}

/* --- About Section --- */
.about-section {
    width: 100%;
    background: #ffffff;
    padding-top: 6rem;
    padding-bottom: 6rem;
}

.about-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
}

.about-image-frame {
    position: relative;
    aspect-ratio: 3/4;
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid #e7e5e4;
    background: #fafaf9;
}

.about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.25);
    object-position: top;
}

.about-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28, 25, 23, 0.6), transparent, transparent);
}

.about-image-info-card {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 0.5rem;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.about-image-info-card .info-name {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.25rem;
    color: #1c1917;
    font-weight: 500;
}

.about-image-info-card .info-title {
    font-size: 10px;
    color: var(--color-gold);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
}

.about-image-info-card .info-initials {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.5rem;
    color: #d6d3d1;
    font-style: serif;
}

.about-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.section-label-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
}

.section-label-line {
    width: 2rem;
    height: 1px;
    background: var(--color-gold);
}

.section-label-text {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.25em;
}

.about-quote {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.25rem;
    font-style: italic;
    color: #44403c;
    line-height: 1.375;
    border-left: 2px solid var(--color-gold);
    padding-left: 1rem;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
}

.about-text {
    font-size: 0.875rem;
    color: #57534e;
    line-height: 1.625;
}

.credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    padding-top: 0.5rem;
}

@media (min-width: 1024px) {
    .credentials-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        padding-top: 0.5rem;
    }
}



.credential-badge {
    padding: 0.875rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    border: 1px solid #e7e5e4;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.credential-badge .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 22px;
}

.credential-badge .credential-label {
    font-size: 11px;
    font-weight: 700;
    color: #292524;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.about-cta {
    padding-top: 1rem;
}

.btn-primary-md {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #141414;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding-left: 2rem;
    padding-right: 2rem;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
    border-radius: 0.25rem;
    letter-spacing: 0.1em;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-primary-md:hover {
    background: var(--color-gold);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.btn-primary-md .material-symbols-outlined {
    font-size: 16px;
}

/* --- Services Section --- */
.services-section {
    width: 100%;
    background: var(--color-surface);
    padding-top: 6rem;
    padding-bottom: 6rem;
}

.services-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4rem;
}

.services-header-text {
    max-width: 28rem;
}

.services-header-description {
    font-size: 0.875rem;
    color: #57534e;
    max-width: 28rem;
    line-height: 1.625;
}

.services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.services-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.services-column-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e7e5e4;
}

.services-column-header .material-symbols-outlined {
    color: var(--color-gold);
}

.services-column-header h3 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #1c1917;
}

.services-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.service-card {
    padding: 1.5rem;
    border-radius: 0.75rem;
    background: #ffffff;
    border: 1px solid rgba(231, 229, 228, 0.8);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 15rem;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.service-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    border-color: rgba(184, 134, 11, 0.5);
}

.service-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
}

.service-card-header .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 22px;
}

.service-card-price-tag {
    font-size: 10px;
    font-weight: 700;
    color: #44403c;
    background: #fffbeb;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    padding-top: 0.125rem;
    padding-bottom: 0.125rem;
    border-radius: 0.25rem;
    border: 1px solid #fde68a;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.service-card-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.125rem;
    color: #1c1917;
    margin-bottom: 0.25rem;
}

.service-card-description {
    font-size: 0.75rem;
    color: #57534e;
    line-height: 1.625;
}

/* --- Stats Section --- */
.stats-section {
    width: 100%;
    background: #ffffff;
    padding-top: 4rem;
    padding-bottom: 4rem;
}

.stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
}

.stat-item {
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
}

.stat-number {
    font-family: 'Bodoni Moda', serif;
    font-size: 2.25rem;
    color: var(--color-gold);
    margin-bottom: 0.25rem;
}

.stat-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #44403c;
}

/* --- Gallery Section --- */
.gallery-section {
    width: 100%;
    background: var(--color-surface);
    padding-top: 4rem;
    padding-bottom: 4rem;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.gallery-item {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    border: 1px solid #e7e5e4;
}

.gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
}

/* .gallery-item:hover .gallery-image {
    filter: grayscale(0%);
} */

.gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent, transparent);
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
}

.gallery-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
}

/* --- Reviews Section --- */
.reviews-section {
    width: 100%;
    background: #ffffff;
    padding-top: 6rem;
    padding-bottom: 6rem;
}

.reviews-header-centered {
    text-align: center;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 4rem;
}

.reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
}

.review-card {
    padding: 2rem;
    background: var(--color-surface);
    border: 1px solid rgba(231, 229, 228, 0.9);
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.15s ease;
}

.review-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.review-stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-gold);
    margin-bottom: 1.25rem;
}

.review-stars .material-symbols-outlined {
    font-size: 18px;
    font-variation-settings: 'FILL' 1;
}

.review-text {
    color: #44403c;
    font-style: italic;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    line-height: 1.625;
}

.review-author-divider {
    padding-top: 1rem;
    border-top: 1px solid #e7e5e4;
}

.review-author-name {
    font-family: 'Bodoni Moda', serif;
    font-size: 1rem;
    font-weight: 600;
    color: #1c1917;
}

.review-author-role {
    font-size: 0.75rem;
    color: #78716c;
}

/* --- Pricing Section --- */
.pricing-section {
    width: 100%;
    background: #f8f6f0;
    padding-top: 6rem;
    padding-bottom: 6rem;
}

.pricing-subtitle {
    font-size: 0.75rem;
    color: #57534e;
    margin-top: 0.5rem;
}

.pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
}

.pricing-card {
    padding: 2rem;
    background: #ffffff;
    border: 1px solid rgba(231, 229, 228, 0.9);
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.15s ease;
}

.pricing-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.pricing-card-featured {
    padding: 2rem;
    background: #ffffff;
    border: 2px solid var(--color-gold);
    border-radius: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
}

.pricing-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-gold);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    border-radius: 9999px;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.pricing-tier-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
}

.pricing-tier-label-muted {
    color: #78716c;
}

.pricing-tier-label-gold {
    color: var(--color-gold);
}

.pricing-card-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 20px;
    color: #1c1917;
    margin-bottom: 1.25rem;
}

.pricing-amount-row {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
}

.pricing-amount {
    font-family: 'Bodoni Moda', serif;
    font-size: 2.25rem;
    color: #1c1917;
}

.pricing-amount-gold-deep {
    color: var(--color-gold-deep);
}

.pricing-period {
    font-size: 0.75rem;
    color: #78716c;
    font-weight: 500;
}

.pricing-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: #57534e;
    margin-bottom: 2rem;
    padding-left: 0;
}

.pricing-feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.pricing-feature .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 16px;
}

.pricing-feature strong {
    color: #1c1917;
    font-weight: 700;
}

.btn-pricing-cta {
    width: 100%;
    text-align: center;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0.25rem;
    background: #f5f5f4;
    color: #292524;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.15s ease, background-color 0.15s ease;
    text-decoration: none;
    display: block;
}

.btn-pricing-cta:hover {
    background: #141414;
    color: #ffffff;
}

.btn-pricing-cta-featured {
    width: 100%;
    text-align: center;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
    border-radius: 0.25rem;
    background: #141414;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
    transition: color 0.15s ease, background-color 0.15s ease;
    text-decoration: none;
    display: block;
}

.btn-pricing-cta-featured:hover {
    background: var(--color-gold);
}

/* --- FAQ Section --- */
.faq-section {
    width: 100%;
    background: #ffffff;
    padding-top: 6rem;
    padding-bottom: 6rem;
}

.faq-header-centered {
    text-align: center;
    margin-bottom: 4rem;
}

.faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.faq-item {
    background: var(--color-surface);
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.faq-button {
    width: 100%;
    padding: 1.5rem;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #1c1917;
    font-weight: 500;
    font-size: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease;
}

.faq-button:hover {
    color: var(--color-gold);
}

.faq-icon {
    color: var(--color-gold);
    transition: transform 0.3s ease;
    font-size: 20px;
}

.faq-content {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-bottom: 1.5rem;
    padding-top: 0;
    color: #57534e;
    font-size: 0.875rem;
    line-height: 1.625;
}

/* --- Consultation Section --- */
.consult-section {
    width: 100%;
    background: #f4f2ec;
    padding-top: 6rem;
    padding-bottom: 6rem;
    position: relative;
    overflow: hidden;
}

.consult-header-centered {
    text-align: center;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
}

.consult-header-centered h2 {
    margin-bottom: 0.75rem;
}

.consult-header-description {
    font-size: 0.875rem;
    color: #57534e;
    line-height: 1.625;
}

.consult-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: flex-start;
}

.consult-form-card {
    background: #ffffff;
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid #e7e5e4;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.consult-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-input::placeholder {
    color: #a8a29e;
}

.form-input:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 1px var(--color-gold);
}

.form-label-pills {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #44403c;
    margin-bottom: 0.625rem;
}

.focus-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
}

.focus-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-left: 0.875rem;
    padding-right: 0.875rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-radius: 9999px;
    border: 1px solid #e7e5e4;
    background: var(--color-surface);
    font-size: 0.75rem;
    color: #44403c;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
}

.focus-pill:hover {
    border-color: var(--color-gold);
}

.focus-pill input {
    display: none;
}

.focus-pill:has(input:checked) {
    background: var(--color-gold);
    color: #ffffff;
    border-color: var(--color-gold);
}

.submit-btn {
    width: 100%;
    padding-top: 1rem;
    padding-bottom: 1rem;
    padding-left: 2rem;
    padding-right: 2rem;
    border-radius: 0.5rem;
    background: #141414;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: none;
    cursor: pointer;
    font-family: inherit;
}

.submit-btn:hover {
    background: var(--color-gold);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}

.submit-btn .material-symbols-outlined {
    font-size: 18px;
}

.form-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
    color: #78716c;
    font-size: 11px;
}

.form-trust-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.form-trust-item .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 14px;
}

.form-trust-separator {
    color: #78716c;
}

/* --- Trust Cards (Sidebar) --- */
.trust-card {
    background: #ffffff;
    padding: 1.75rem;
    border-radius: 1rem;
    border: 1px solid #e7e5e4;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.trust-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #f5f5f4;
}

.trust-avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 9999px;
    overflow: hidden;
    border: 2px solid var(--color-gold);
    flex-shrink: 0;
    background: #f5f5f4;
}

.trust-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(100%);
}

.trust-card-header .direct-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.trust-card-header .founder-name {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.25rem;
    color: #1c1917;
}

.trust-card-header .founder-role {
    font-size: 0.75rem;
    color: #78716c;
}

.trust-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    font-size: 0.75rem;
    color: #44403c;
    padding-left: 0;
}

.trust-list-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.trust-list-icon-box {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.25rem;
    background: #fffbeb;
    border: 1px solid #fef3c7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
}

.trust-list-icon-box .material-symbols-outlined {
    font-size: 16px;
}

.trust-list-item a {
    color: #44403c;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
}

.trust-list-item a:hover {
    color: var(--color-gold);
}

/* --- Discretion Card --- */
.discretion-card {
    background: #ffffff;
    padding: 1.75rem;
    border-radius: 1rem;
    border: 1px solid #e7e5e4;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.discretion-card-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
}

.discretion-card-header .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 22px;
}

.discretion-card-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.125rem;
    color: #1c1917;
}

.discretion-card-text {
    font-size: 0.75rem;
    color: #57534e;
    line-height: 1.625;
}

.discretion-highlight {
    padding-top: 0.5rem;
}

.discretion-highlight-box {
    padding: 0.75rem;
    background: var(--color-surface);
    border-radius: 0.25rem;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.discretion-highlight-box .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 20px;
}

.discretion-highlight-box p {
    font-size: 11px;
    color: #44403c;
    font-weight: 500;
}

/* --- Footer --- */
.site-footer {
    width: 100%;
    background: #ffffff;
    padding-top: 0rem;
    padding-bottom: 0rem;
    position: relative;
    overflow: hidden;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
}

.footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-brand-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.footer-brand-img-wrapper {
    height: 2.25rem;
    width: 5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.footer-brand-img {
    height: 3rem;
    width: auto;
    object-fit: cover;
    filter: contrast(1.5);
}

.footer-brand-text {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.25rem;
    letter-spacing: 0.2em;
    color: #141414;
    font-weight: 500;
}

.footer-tagline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--color-gold);
    text-transform: uppercase;
}

.footer-description {
    font-size: 0.75rem;
    color: #57534e;
    max-width: 24rem;
    line-height: 1.625;
}

.footer-social-icons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
}

.footer-social-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #57534e;
    transition: color 0.15s ease, border-color 0.15s ease;
    text-decoration: none;
}

.footer-social-icon:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
}

.footer-social-icon .material-symbols-outlined {
    font-size: 16px;
}

.footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.footer-nav-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #1c1917;
    letter-spacing: 0.1em;
}

.footer-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #57534e;
}

.footer-nav-link {
    color: #57534e;
    transition: color 0.15s ease;
    text-decoration: none;
}

.footer-nav-link:hover {
    color: var(--color-gold);
}

.footer-details-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.footer-details-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #1c1917;
    letter-spacing: 0.1em;
}

.footer-details-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: #57534e;
}

.footer-detail-item strong {
    color: #1c1917;
    font-weight: 500;
}

.footer-location-note {
    margin-top: 0.5rem;
    color: #78716c;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
}

.footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid #e7e5e4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: center;
}

.footer-tagline-italic {
    font-family: 'Bodoni Moda', serif;
    font-size: 0.875rem;
    font-style: italic;
    color: #292524;
    font-weight: 500;
}

.footer-copyright {
    font-size: 0.75rem;
    color: #78716c;
}

/* ============================================
   RESPONSIVE BREAKPOINTS
   ============================================ */

/* sm: 640px */
@media (min-width: 640px) {
    .brand-text {
        display: inline-block;
    }

    .hero-title {
        font-size: 3rem;
    }

    .hero-buttons {
        flex-direction: row;
        align-items: center;
        width: auto;
    }

    .services-card-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .about-text {
        font-size: 1rem;
    }

    .reviews-header-centered {
        max-width: 36rem;
    }
}

/* md: 768px */
@media (min-width: 768px) {
    .header-inner {
        padding-left: 2.5rem;
        padding-right: 2.5rem;
    }

    .btn-cta-primary {
        display: inline-flex;
    }

    .section-container,
    .section-container-narrow,
    .section-container-medium {
        padding-left: 2.5rem;
        padding-right: 2.5rem;
    }

    .section-title {
        font-size: 2.25rem;
    }

    .review-text {
        font-size: 1rem;
    }

    .stats-grid {
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid #e7e5e4;
    }

    .stats-grid .stat-item:not(:first-child) {
        border-top: none;
    }

    .reviews-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .footer-bottom {
        flex-direction: row;
        text-align: left;
    }
}

@media (min-width: 768px) {
    .problem-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .gallery-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

/* lg: 1024px */
@media (min-width: 1024px) {
    .main-nav {
        display: flex;
    }

    .hero-inner {
        grid-template-columns: repeat(12, 1fr);
        padding-top: 6rem;
        padding-bottom: 6rem;
    }

    .hero-content {
        grid-column: span 6;
    }

    .hero-image-wrapper {
        grid-column: span 5;
        justify-content: flex-end;
    }

    .hero-title {
        font-size: 3.75rem;
    }

    .about-inner {
        grid-template-columns: repeat(12, 1fr);
    }

    .about-image-frame {
        grid-column: span 5;
    }

    .about-narrative {
        grid-column: span 7;
    }

    .services-grid {
        grid-template-columns: repeat(1, 1fr);
    }

    .pricing-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .pricing-card-featured {
        transform: translateY(-0.5rem);
    }

    .consult-grid {
        grid-template-columns: repeat(12, 1fr);
    }

    .consult-form-card {
        grid-column: span 8;
        padding: 2.5rem;
    }

    .consult-sidebar {
        grid-column: span 4;
    }

    .consult-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .footer-grid {
        grid-template-columns: repeat(12, 1fr);
    }

    .footer-brand-col {
        grid-column: span 5;
    }

    .footer-nav-col {
        grid-column: span 3;
    }

    .footer-details-col {
        grid-column: span 4;
    }

    .section-title-lg {
        font-size: 3rem;
    }

    .faq-section .section-container-narrow {
        max-width: 880px;
    }
}

/* ============================================
   KEYFRAME ANIMATIONS
   ============================================ */
@keyframes pulse {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }
}

@media (min-width: 1024px) {
    .image-box {
        grid-column-start: span 5;
    }
}

.faq-content.hidden {
    display: none;
}

.header .header-announcement-bar-wrapper {
    padding-top: 0px;
    padding-bottom: 0px;
    position: relative;
    transition: all 0.3s ease;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-surface-border);
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.03);
    border: 0;
}

.header .header-announcement-bar-wrapper.is-fixed {
    position: fixed;
}

.header .header-announcement-bar-wrapper .header-border[data-header-border="true"] {
    border: none;
}

.header-nav-item.header-nav-item--external:last-child {
    align-items: center;
    justify-content: center;
    background: #141414;
    color: #ffffff !important;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0.25rem;
    border: 1px solid #141414;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    text-decoration: none;
}

.header-nav-item.header-nav-item--external:last-child a {
    color: #fff;
}

.form-success-message {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
    gap: 0.75rem;
}

.form-success-message .material-symbols-outlined {
    color: var(--color-gold);
    font-size: 48px;
}

.form-success-message h3 {
    color: var(--color-primary);
    font-family: "Bodoni Moda", serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
}

.form-success-message p {
    color: var(--color-on-surface-variant);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 28rem;
    margin: 0;
}

.form-input {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid #e7e5e4;
    border-radius: .5rem;
    padding: .75rem 1rem;
    font-size: .875rem;
    color: #1c1917;
    transition: border-color .15s ease, box-shadow .15s ease;
    -webkit-appearance: none;
    appearance: none;
    font-family: inherit;
    box-sizing: border-box;
    /* Ensures width calculations include padding */
}

.form-row-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    /* Gap between row & columns */
}

@media (min-width: 640px) {
    .form-row-2col {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        /* Prevents horizontal overflow */
    }
}

.form-label {
    display: block;
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #44403c;
    margin-bottom: .5rem;
}

.footer-details-list p {
    margin: .5rem;
}