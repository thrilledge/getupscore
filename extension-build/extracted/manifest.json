{
  "manifest_version": 3,
  "name": "Get UpScore",
  "version": "1.0.5",
  "description": "AI-powered Upwork opportunity finder — job alerts, scoring, and proposals.",
  "homepage_url": "https://www.getupscore.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "https://www.getupscore.com/*",
    "https://getupscore.com/*",
    "https://www.upwork.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/*"],
      "js": ["upscore-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.getupscore.com/*", "https://getupscore.com/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/main-world.js", "icons/getupscore-logo-icon.png", "icons/upscore-logo-white.png", "icons/upscore-logo-black.png"],
      "matches": ["https://www.upwork.com/*", "https://www.getupscore.com/*", "https://getupscore.com/*"]
    }
  ],
  "action": {
    "default_title": "Get UpScore — Open Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
